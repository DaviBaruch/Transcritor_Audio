# Configuração recomendada para a instalação pública no VPS.
# O Nginx fica exposto na internet; o Flask permanece atrás dele.
TRANSCRITOR_HOST=127.0.0.1
TRANSCRITOR_PORT=5055
TRANSCRITOR_THREADS=4
TRANSCRITOR_PUBLIC_MODE=1
TRANSCRITOR_ALLOW_REGISTRATION=0
TRANSCRITOR_OLLAMA_ENABLED=0
TRANSCRITOR_DATA_ROOT=/var/lib/transcritor
TRANSCRITOR_COOKIE_SECURE=1
TRANSCRITOR_MAX_UPLOAD_MB=2048

# Gere um valor aleatório longo e mantenha somente no VPS.
TRANSCRITOR_SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_LONGA_E_ALEATORIA
