# O padrão é local. Só altere HOST quando o acesso pela rede estiver preparado.
TRANSCRITOR_HOST=127.0.0.1
TRANSCRITOR_PORT=5055
TRANSCRITOR_MAX_UPLOAD_MB=2048
TRANSCRITOR_THREADS=4
TRANSCRITOR_PUBLIC_MODE=0
TRANSCRITOR_ALLOW_REGISTRATION=1
TRANSCRITOR_DATA_ROOT=./dados_usuarios
TRANSCRITOR_OLLAMA_ENABLED=1

# Use 1 somente quando o site estiver atrás de HTTPS.
TRANSCRITOR_COOKIE_SECURE=0

# Opcional: defina uma chave longa em produção para não depender do arquivo local.
# TRANSCRITOR_SECRET_KEY=troque-por-um-valor-aleatorio-longo
